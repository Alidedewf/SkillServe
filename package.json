{
  "name": "skillserve-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api-front-ss",
    "api-backend-ss-main"
  ],
  "scripts": {
    "start:frontend": "npm run start --workspace=api-front-ss",
    "start:backend": "npm run dev --workspace=api-backend-ss-main",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "build:frontend": "npm run build --workspace=api-front-ss",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
