// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Роли пользователей ──────────────────────────────────────────────
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

// ─── Статус курса ────────────────────────────────────────────────────
enum CourseStatus {
  ACTIVE
  ARCHIVED
}

// ─── Тип урока ───────────────────────────────────────────────────────
enum LessonType {
  VIDEO
  TEXT
}

// ─── Статус прохождения курса ─────────────────────────────────────────
enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────────────────────────────────────────────────
// РЕСТОРАН (TENANT)
// ─────────────────────────────────────────────────────────────────────
model Restaurant {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  logo_url   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Связи
  users          User[]
  departments    Department[]
  positions      Position[]
  courses        Course[]
  menuCategories MenuCategory[]
  settings       RestaurantSetting[]
  achievements   Achievement[]
}

// ─────────────────────────────────────────────────────────────────────
// ОТДЕЛЫ (динамическая оргструктура)
// ─────────────────────────────────────────────────────────────────────
model Department {
  id            Int    @id @default(autoincrement())
  restaurant_id Int
  name          String
  order         Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  positions  Position[]

  @@unique([restaurant_id, name])
}

// ─────────────────────────────────────────────────────────────────────
// ДОЛЖНОСТИ
// ─────────────────────────────────────────────────────────────────────
model Position {
  id            Int    @id @default(autoincrement())
  restaurant_id Int
  department_id Int?
  name          String
  order         Int    @default(0)

  restaurant Restaurant  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  users      User[]

  @@unique([restaurant_id, name])
}

// ─────────────────────────────────────────────────────────────────────
// ПОЛЬЗОВАТЕЛИ
// ─────────────────────────────────────────────────────────────────────
model User {
  id            Int      @id @default(autoincrement())
  restaurant_id Int?
  position_id   Int?
  name          String
  email         String   @unique
  password      String
  role          Role     @default(USER)
  avatar_url    String?
  language      String   @default("ru")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Связи
  restaurant     Restaurant?          @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  position       Position?            @relation(fields: [position_id], references: [id], onDelete: SetNull)
  progress       UserCourseProgress[]
  lessonProgress UserLessonProgress[]
  testAttempts   TestAttempt[]
  achievements   UserAchievement[]
  notifications  Notification[]
}

// ─────────────────────────────────────────────────────────────────────
// КУРСЫ
// ─────────────────────────────────────────────────────────────────────
model Course {
  id            Int          @id @default(autoincrement())
  restaurant_id Int
  title         String
  description   String?
  category      String       @default("Сервис")
  image_url     String?
  language      String       @default("ru")
  status        CourseStatus @default(ACTIVE)
  created_at    DateTime     @default(now())

  // Связи
  restaurant   Restaurant           @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  tests        Test[]
  progress     UserCourseProgress[]
  achievements Achievement[]
}

// ─────────────────────────────────────────────────────────────────────
// УРОКИ
// ─────────────────────────────────────────────────────────────────────
model Lesson {
  id          Int        @id @default(autoincrement())
  course_id   Int
  title       String
  type        LessonType
  content_url String?
  content     String?    // Для текстовых уроков
  order       Int
  created_at  DateTime   @default(now())

  course      Course               @relation(fields: [course_id], references: [id], onDelete: Cascade)
  completions UserLessonProgress[]
}

// ─────────────────────────────────────────────────────────────────────
// ТЕСТЫ
// ─────────────────────────────────────────────────────────────────────
model Test {
  id        Int    @id @default(autoincrement())
  course_id Int
  title     String
  min_score Int    @default(5)

  course    Course       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  TestAttempt[]
}

model Question {
  id        Int      @id @default(autoincrement())
  test_id   Int
  content   String
  image_url String?
  type      String   @default("SINGLE") // SINGLE | MULTIPLE | TRUE_FALSE | SCENARIO | MATCHING

  test    Test     @relation(fields: [test_id], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id           Int     @id @default(autoincrement())
  question_id  Int
  content      String
  is_correct   Boolean @default(false)
  match_target String? // Правая часть пары для вопросов типа MATCHING

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────
// ПРОГРЕСС И РЕЗУЛЬТАТЫ
// ─────────────────────────────────────────────────────────────────────
model UserCourseProgress {
  id        Int            @id @default(autoincrement())
  user_id   Int
  course_id Int
  progress  Float          @default(0)
  status    ProgressStatus @default(NOT_STARTED)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
}

model UserLessonProgress {
  id           Int      @id @default(autoincrement())
  user_id      Int
  lesson_id    Int
  completed_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
}

model TestAttempt {
  id              Int      @id @default(autoincrement())
  user_id         Int
  test_id         Int
  correct_count   Int
  total_questions Int
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  test Test @relation(fields: [test_id], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────
// ДОСТИЖЕНИЯ
// ─────────────────────────────────────────────────────────────────────
model Achievement {
  id            Int     @id @default(autoincrement())
  restaurant_id Int
  title         String
  description   String?
  image_url     String?
  course_id     Int?    // null = глобальное достижение ресторана

  restaurant Restaurant       @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  course     Course?           @relation(fields: [course_id], references: [id])
  users      UserAchievement[]
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  earned_at      DateTime @default(now())

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_id])
}

// ─────────────────────────────────────────────────────────────────────
// МЕНЮ РЕСТОРАНА
// ─────────────────────────────────────────────────────────────────────
model MenuCategory {
  id            Int    @id @default(autoincrement())
  restaurant_id Int
  name          String
  order         Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  items      MenuItem[]
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  category_id Int
  title       String
  description String?
  price       String?  // String to allow "500 тг" or similar
  portion     String?  // e.g. "300 г" or "1 шт"
  image_url   String?
  visible_to  String[] // ["Официант", "Бармен"], empty means all
  sales_guide Json?    // AI Sales Guide: { sellingPhrase, upsell, crossSell, premiumOffer, guestQuestions[], guestAnswers[], keyAdvantages[], status }

  category MenuCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────
// НАСТРОЙКИ РЕСТОРАНА
// ─────────────────────────────────────────────────────────────────────
model RestaurantSetting {
  id            Int    @id @default(autoincrement())
  restaurant_id Int
  key           String
  value         String

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([restaurant_id, key])
}

// ─────────────────────────────────────────────────────────────────────
// УВЕДОМЛЕНИЯ
// ─────────────────────────────────────────────────────────────────────
model Notification {
  id            Int      @id @default(autoincrement())
  user_id       Int
  restaurant_id Int?
  title         String
  message       String
  is_read       Boolean  @default(false)
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

