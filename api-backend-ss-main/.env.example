# Environment Variables (локальная разработка без Docker)

# Database — локальный Postgres. Для Docker см. корневой .env.docker.example
DATABASE_URL="postgresql://USER@localhost:5432/skillserve"

# JWT (обязателен в production; сгенерировать: openssl rand -hex 32)
JWT_SECRET="your-super-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5001

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Cookie secure (true за HTTPS; для локалки/HTTP оставь пустым)
# COOKIE_SECURE=false

# AI (генерация Sales Guide / курсов)
# GEMINI_API_KEY=
