# ─── Docker Compose env (скопируй в .env: cp .env.docker.example .env) ───

# База данных (контейнер Postgres)
POSTGRES_USER=skillserve
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=skillserve

# JWT — ОБЯЗАТЕЛЬНО задать сильный случайный секрет
# сгенерировать: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Внешний порт веб-приложения (http://<host>:WEB_PORT)
WEB_PORT=8080

# URL фронтенда (для CORS). За доменом — https://your-domain
CLIENT_URL=http://localhost:8080

# Cookie secure: false для HTTP, true за HTTPS-прокси
COOKIE_SECURE=false

# AI (генерация Sales Guide / курсов). Без ключа AI-функции недоступны.
GEMINI_API_KEY=
